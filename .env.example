# Runtime mode. Production fails closed if API keys are absent.
GRIDLENS_ENV=development

# Comma-separated key|username|role entries.
# Example only: replace with a secret manager in production.
GRIDLENS_API_KEYS=dev-engineer-key|engineer-alice|ENGINEER,dev-approver-key|approver-bob|APPROVER

# Comma-separated browser origins.
GRIDLENS_ALLOWED_ORIGINS=http://localhost:3000

# The demo intentionally uses deterministic report generation.
LLM_PROVIDER=mock
